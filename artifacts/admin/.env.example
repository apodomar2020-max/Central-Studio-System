# ─── Admin dashboard — environment variables ──────────────────────────────────
# In Vercel: Project → Settings → Environment Variables.
# Prefix VITE_ is required — Vite only exposes variables with this prefix.

# Full URL of the deployed API server (no trailing slash).
# Example: https://centralstudio-api.up.railway.app
VITE_API_URL=https://your-api.up.railway.app

# The same API secret key set in the API server's API_SECRET_KEY.
# Sent as the X-Api-Key request header on every API call.
VITE_API_KEY=your-api-secret-key-here
