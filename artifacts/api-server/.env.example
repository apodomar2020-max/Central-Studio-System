# ─── API Server — environment variables ───────────────────────────────────────
# Copy this file to .env and fill in the values before running locally.
# On Railway, set these in: Project → Variables.

# Port the HTTP server listens on.
# Railway sets this automatically — leave it unset in the Railway dashboard.
PORT=3000

# Node environment. Always "production" on Railway.
NODE_ENV=production

# Full PostgreSQL connection string.
# Railway injects DATABASE_URL automatically when you add a Postgres plugin.
#
# LOCAL DEV: always use a LOCAL Postgres database, e.g.
#   postgresql://centralstudio_user:changeme@localhost:5432/centralstudio
# NEVER paste Railway's DATABASE_PUBLIC_URL (…proxy.rlwy.net) here — that is
# the PRODUCTION database. A safety guard refuses to start/migrate locally
# against Railway hosts. Emergency override (dangerous, deliberate manual
# operations only): ALLOW_REMOTE_DATABASE_LOCAL=true
DATABASE_URL=postgresql://centralstudio_user:changeme@localhost:5432/centralstudio

# There is no shared server-to-server API secret in this system. Public/auth
# routes need no credential, student routes are gated by a student JWT, and
# admin routes are gated by an admin JWT + RBAC — each verified independently.

# Secret used to sign and verify student access tokens (JWTs).
# Must be different from ADMIN_JWT_SECRET.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value secret — never commit it or share it.
# If this is missing in production the server will refuse to start.
STUDENT_JWT_SECRET=

# Secret used to sign admin session tokens. Must differ from STUDENT_JWT_SECRET.
# Generate independently:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# ─── Transactional email ─────────────────────────────────────────────────────

# Brevo (formerly Sendinblue) Transactional Email API key used for email
# verification OTP, password reset OTP, and password security notification
# emails. Sent via native fetch() to https://api.brevo.com/v3/smtp/email.
# Set the real value in Railway → Variables. Never commit it.
BREVO_API_KEY=

# Verified sender address from your Brevo-authenticated domain. Accepts either
# "Display Name <email>" or a bare email address — both are parsed into
# Brevo's { name?, email } sender object automatically.
# Example: Central Studio <no-reply@centralstudioco.com>
EMAIL_FROM=Central Studio <no-reply@centralstudioco.com>

# Optional reply-to address for transactional emails.
EMAIL_REPLY_TO=support@centralstudioco.com

# Comma-separated list of allowed CORS origins (admin dashboard URL).
# Example: https://centralstudio-admin.vercel.app
# Leave empty during local development — all origins are allowed in dev.
ALLOWED_ORIGINS=https://your-admin.vercel.app

# ─── Social sign-in ───────────────────────────────────────────────────────────

# Google: comma-separated list of accepted OAuth client IDs (audiences).
# Include the web + android + ios client IDs so id_tokens from any platform pass.
GOOGLE_CLIENT_ID=

# Facebook Login. The App ID is public; the App Secret is a SECRET — set the
# real values in Railway → Variables (or your shell), never commit them.
# The backend builds the app access token as `APP_ID|APP_SECRET` to validate
# user tokens server-side via the Graph debug_token endpoint.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional. Only needed by the native Facebook SDK; the AuthSession flow used
# here does not require it server-side. Treat as a secret if set.
FACEBOOK_CLIENT_TOKEN=

# ─── Instagram Reels ──────────────────────────────────────────────────────────

# Instagram Business account User ID (numeric).
# Found on the Meta Developer portal → Roles → Instagram Testers → your account.
# Example: 17841405298341228
INSTAGRAM_USER_ID=

# Long-lived Instagram access token (valid 60 days, refresh before expiry).
# Exchange a short-lived token at:
#   curl "https://graph.instagram.com/access_token?grant_type=ig_exchange_token\
#     &client_id=APP_ID&client_secret=APP_SECRET&access_token=SHORT_LIVED_TOKEN"
# Set the real value in Railway → Variables. Never commit it.
INSTAGRAM_ACCESS_TOKEN=

# Optional non-secret revision label for a deliberate provider-token rotation.
# When both values are set and this label differs from the encrypted DB row,
# the API replaces the stored token through the encrypted write path. Use a new
# opaque label (for example 2026-rotation-1), verify, then remove both bootstrap
# variables. Never put the token itself in this label.
INSTAGRAM_ACCESS_TOKEN_REVISION=

# API-only authenticated-encryption key for long-lived third-party tokens
# persisted in Postgres. Exactly 32 random bytes, base64 encoded. Never set
# this on the Worker, Admin, Mobile, Website, or any EXPO_PUBLIC_* variable.
# Generate without printing it into shared logs, then store it in Railway's
# encrypted API-service variables.
THIRD_PARTY_TOKEN_ENCRYPTION_KEY=
THIRD_PARTY_TOKEN_ENCRYPTION_KEY_VERSION=v1

# Optional decrypt-only keyring used during staged key rotation. JSON object
# mapping prior version labels to base64 keys. New writes always use the
# current key above. Example shape only: {"v0":"<base64-32-byte-key>"}
THIRD_PARTY_TOKEN_PREVIOUS_ENCRYPTION_KEYS=

# ─── Bot Protection (Security Wave) ────────────────────────────────────────────

# Cloudflare Turnstile secret key. API-only — never Worker, Admin, Mobile, or
# Vercel. Create a Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile
# and paste its Secret Key here. Register/forgot-password/OTP send/resend fail
# closed (503) until this is set.
TURNSTILE_SECRET_KEY=

# Domain-separated pepper for Redis auth-abuse rate-limit account keys
# (Security Wave — Auth Abuse Foundation). Never reuse OTP_PEPPER.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ABUSE_PEPPER=
