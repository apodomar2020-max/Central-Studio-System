{
  "expo": {
    "name": "Central Studio & Stage",
    "slug": "central",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "central",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060C10"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.centralstudio.app",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark"
      }
    },
    "android": {
      "package": "com.centralstudio.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#060C10"
      },
      "backgroundColor": "#060C10"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "backgroundColor": "#060C10"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
