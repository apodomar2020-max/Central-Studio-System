{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-cli/schema/eas.schema.json",
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "EXPO_NO_FROZEN_LOCKFILE": "1",
        "EXPO_PUBLIC_API_URL": "https://supportive-magic-production-b800.up.railway.app",
        "EXPO_PUBLIC_API_KEY": "34c0dbe7c8891faaa734dcd2fdf1c7592b890f8f75988ab5e863b155f0d97665"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {},
      "channel": "production",
      "env": {
        "EXPO_NO_FROZEN_LOCKFILE": "1",
        "EXPO_PUBLIC_API_URL": "https://supportive-magic-production-b800.up.railway.app",
        "EXPO_PUBLIC_API_KEY": "34c0dbe7c8891faaa734dcd2fdf1c7592b890f8f75988ab5e863b155f0d97665"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "your@apple.com",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_TEAM_ID"
      }
    }
  }
}
