# ─── Mobile app — environment variables ───────────────────────────────────────
# These are baked into the app at build time by Expo.
# Set them in the EAS dashboard (eas.json env section or Build secrets)
# OR in a local .env file for local dev.
#
# IMPORTANT: All EXPO_PUBLIC_* values are visible in the app bundle.
# Never put a secret here — only the API key (which is already semi-public).

# Full URL of the deployed API server (no trailing slash).
# Example: https://centralstudio-api.up.railway.app
EXPO_PUBLIC_API_URL=https://your-api.up.railway.app

# The same API secret key set in the API server's API_SECRET_KEY.
# Sent as: Authorization: Bearer <key>
EXPO_PUBLIC_API_KEY=your-api-secret-key-here

# ─── Social sign-in (public client identifiers only) ──────────────────────────

# Google OAuth client IDs (safe defaults are baked into constants/google.ts;
# override here only if needed).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Facebook App ID (public). The App Secret / Client Token are NEVER set here —
# they live only on the backend. Without this value the Facebook button is hidden.
EXPO_PUBLIC_FACEBOOK_APP_ID=
