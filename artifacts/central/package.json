{
  "name": "@workspace/central",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "@types/react",
        "@types/react-dom"
      ]
    }
