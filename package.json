{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test:ballet:integration": "pnpm --filter @workspace/scripts run test:ballet:integration",
    "finance:backfill:dry-run": "pnpm --filter @workspace/api-server run finance:backfill:dry-run",
    "finance:backfill:execute": "pnpm --filter @workspace/api-server run finance:backfill:execute",
    "finance:backfill:production-dry-run": "pnpm --filter @workspace/api-server run finance:backfill:production-dry-run",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:mobile": "sh ./test-mobile.sh"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "minimatch": "^9.0.0"
    }
  },
  "devDependencies": {
    "@esbuild/darwin-arm64": "0.27.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@sentry/react-native": "^8.17.2"
  }
}
