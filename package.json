{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test:ballet:integration": "pnpm --filter @workspace/scripts run test:ballet:integration",
    "finance:backfill:dry-run": "pnpm --filter @workspace/api-server run finance:backfill:dry-run",
    "finance:backfill:execute": "pnpm --filter @workspace/api-server run finance:backfill:execute",
    "finance:backfill:production-dry-run": "pnpm --filter @workspace/api-server run finance:backfill:production-dry-run",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:mobile": "sh ./test-mobile.sh"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2 <3": "2.1.4",
      "esbuild@>=0.27 <0.28": "0.27.7",
      "esbuild@>=0.28 <0.29": "0.28.1",
      "fast-uri@>=3 <4": "3.1.5",
      "ip-address@>=10 <11": "10.3.1",
      "js-yaml@>=3 <4": "3.15.1",
      "js-yaml@>=4 <5": "4.3.1",
      "lodash@>=4 <5": "4.18.1",
      "minimatch": "^9.0.0",
      "nanoid@>=3 <4": "3.3.18",
      "postcss@>=8 <9": "8.5.23",
      "qs@>=6 <7": "6.15.2",
      "shell-quote@>=1 <2": "1.9.0",
      "tar@>=7 <8": "7.5.21",
      "undici@>=6 <7": "6.28.0"
    }
  },
  "devDependencies": {
    "@esbuild/darwin-arm64": "0.27.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@sentry/react-native": "^8.17.2"
  }
}
